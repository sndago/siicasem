<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Siicasem — Loan · <%= account.accountNumber %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/client.css">
  <link rel="stylesheet" href="/css/form.css">
  <style>
    /* allow tall content to scroll instead of clipping */
    .page-content { overflow-y: auto !important; display: block !important; }

    /* loan page header — mirrors .client-hero without the photo upload */
    .client-header {
      display: flex; align-items: flex-start; gap: 1.25rem;
      background: #fff; border: 1px solid #e8edf5; border-radius: 1rem;
      padding: 1.375rem 1.75rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.04), 0 4px 16px rgba(0,0,0,.03);
      margin-bottom: 1.25rem;
    }
    .client-avatar {
      width: 56px; height: 56px; border-radius: .875rem;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .client-info { flex: 1; min-width: 0; }
    .client-name {
      font-size: 1.25rem; font-weight: 700; color: #0f172a;
      letter-spacing: -.02em; display: flex; align-items: center;
      gap: .6rem; flex-wrap: wrap; margin-bottom: .4rem;
    }
    .client-meta {
      display: flex; align-items: center; gap: .5rem;
      flex-wrap: wrap; font-size: .8rem; color: #64748b;
    }
    .client-meta span { display: inline-flex; align-items: center; }
    /* ── Loan detail specific ───────────────────── */
    .loan-detail-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    @media (max-width: 640px) { .loan-detail-grid { grid-template-columns: 1fr; } }

    .loan-info-card {
      background: #fff;
      border: 1.5px solid #e2e8f0;
      border-radius: .875rem;
      padding: 1.25rem 1.5rem;
    }
    .loan-info-card-title {
      font-size: .72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: .07em; color: #94a3b8; margin-bottom: 1rem;
      display: flex; align-items: center; gap: .4rem;
    }
    .loan-info-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: .5rem 0; border-bottom: 1px solid #f1f5f9; gap: .5rem;
    }
    .loan-info-row:last-child { border-bottom: none; padding-bottom: 0; }
    .loan-info-key { font-size: .82rem; color: #64748b; font-weight: 500; }
    .loan-info-val { font-size: .88rem; font-weight: 700; color: #0f172a; text-align: right; font-variant-numeric: tabular-nums; }
    .loan-info-val.green  { color: #059669; }
    .loan-info-val.amber  { color: #d97706; }
    .loan-info-val.violet { color: #7c3aed; }
    .loan-info-val.red    { color: #dc2626; }

    .loan-status-pill {
      display: inline-flex; align-items: center; gap: .3rem;
      padding: .2rem .65rem; border-radius: 99px; font-size: .75rem; font-weight: 700;
    }
    .loan-status-pill.active    { background:#fef9c3; color:#92400e; border:1px solid #fbbf24; }
    .loan-status-pill.completed { background:#dcfce7; color:#15803d; border:1px solid #86efac; }
    .loan-status-pill.defaulted { background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5; }
    .loan-status-pill.none      { background:#f1f5f9; color:#64748b; border:1px solid #e2e8f0; }

    .rate-row { display: flex; gap: .5rem; align-items: center; }
    .rate-chip {
      display: inline-flex; align-items: center; gap: .2rem;
      padding: .15rem .5rem; border-radius: 99px; font-size: .75rem; font-weight: 700;
    }
    .rate-chip.first      { background:#fef3c7; color:#92400e; border:1px solid #fbbf24; }
    .rate-chip.subsequent { background:#ede9fe; color:#5b21b6; border:1px solid #a78bfa; }

    .progress-bar-wrap {
      height: 6px; background: #f1f5f9; border-radius: 99px; overflow: hidden; margin-top: .5rem;
    }
    .progress-bar-fill {
      height: 100%; border-radius: 99px; background: linear-gradient(90deg, #6366f1, #8b5cf6);
      transition: width .4s;
    }
    .progress-label {
      display: flex; justify-content: space-between; font-size: .7rem; color: #94a3b8; margin-top: .3rem;
    }

    .no-loan-state {
      text-align: center; padding: 3rem 1rem;
      background: #fff; border: 1.5px dashed #e2e8f0; border-radius: .875rem;
    }
    .no-loan-state-icon {
      width: 52px; height: 52px; background: #f8fafc; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1rem; color: #94a3b8;
    }
    .no-loan-state h3 { font-size: 1rem; font-weight: 700; color: #1e293b; margin-bottom: .35rem; }
    .no-loan-state p  { font-size: .85rem; color: #64748b; margin-bottom: 1.25rem; }

    .txn-table { width: 100%; border-collapse: collapse; }
    .txn-table th {
      font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
      color: #94a3b8; padding: .6rem 1rem; text-align: left; border-bottom: 1.5px solid #f1f5f9;
    }
    .txn-table td {
      padding: .75rem 1rem; font-size: .84rem; border-bottom: 1px solid #f8fafc;
      vertical-align: middle;
    }
    .txn-table tr:last-child td { border-bottom: none; }
    .txn-table tr:hover td { background: #fafafa; }
    .txn-amount { font-weight: 700; font-variant-numeric: tabular-nums; color: #dc2626; }
    .txn-balance { font-weight: 600; color: #374151; font-variant-numeric: tabular-nums; }
    .txn-ref { font-family: monospace; font-size: .75rem; color: #94a3b8; letter-spacing: .04em; }
    .empty-interest {
      text-align: center; padding: 2.5rem; color: #94a3b8; font-size: .85rem;
    }
    .section-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: .875rem;
    }
    .section-header h3 { font-size: .95rem; font-weight: 700; color: #1e293b; }
    .table-wrap {
      background: #fff; border: 1.5px solid #e2e8f0; border-radius: .875rem; overflow: hidden;
    }
    .action-row {
      display: flex; gap: .625rem; flex-wrap: wrap; margin-bottom: 1.25rem;
    }
    .btn-loan-action {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .55rem 1.1rem; border-radius: .5rem; font-size: .83rem; font-weight: 600;
      text-decoration: none; border: 1.5px solid transparent; transition: all .15s;
    }
    .btn-loan-action.primary { background:#6366f1; color:#fff; border-color:#6366f1; }
    .btn-loan-action.primary:hover { background:#4f46e5; }
    .btn-loan-action.secondary { background:#fff; color:#374151; border-color:#e2e8f0; }
    .btn-loan-action.secondary:hover { background:#f8fafc; border-color:#cbd5e1; }
    .btn-loan-action.amber { background:#fef9c3; color:#92400e; border-color:#fbbf24; }
    .btn-loan-action.amber:hover { background:#fef08a; }
    .btn-loan-action.danger { background:#fee2e2; color:#b91c1c; border-color:#fca5a5; }
    .btn-loan-action.danger:hover { background:#fecaca; border-color:#f87171; }
    .btn-loan-action.muted { background:#f8fafc; color:#94a3b8; border-color:#e2e8f0; cursor:not-allowed; }
  </style>
</head>
<body>
<%
  const roleLabels = { super_admin: 'Super Admin', admin: 'Admin', teller: 'Teller' };
  const isAdmin    = ['admin','super_admin'].includes(user.role);
  const fmt   = n  => Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmtDate = d => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  const loan = activeLoan || null;

  let periodsTotal = 0, periodsRemaining = 0, progressPct = 0;
  if (loan) {
    const FREQ_MONTHS = { monthly: 1, quarterly: 3, annually: 12 };
    const mpp = FREQ_MONTHS[loan.interestFrequency] || 1;
    periodsTotal     = Math.max(1, Math.ceil(loan.amortization / mpp));
    periodsRemaining = Math.max(0, periodsTotal - loan.periodsCharged);
    progressPct      = Math.min(100, Math.round((loan.periodsCharged / periodsTotal) * 100));
  }
%>
<div class="layout">

  <!-- ── Sidebar ──────────────────────────────── -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <svg viewBox="0 0 40 40" width="26" height="26" fill="none">
        <polygon points="20,3 38,37 2,37" fill="#6366f1"/>
      </svg>
      <span class="logo-text">SIICASEM</span>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        Dashboard
      </a>
      <a href="/clients" class="nav-link active">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Clients
      </a>
      <a href="/transactions" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="17" y1="7" x2="7" y2="7"/>
          <polyline points="14 4 17 7 14 10"/>
          <line x1="7" y1="17" x2="17" y2="17"/>
          <polyline points="10 14 7 17 10 20"/>
        </svg>
        Transactions
      </a>
      <% if (['admin','super_admin'].includes(user.role)) { %>
      <a href="/requests" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
        </svg>
        Requests
      </a>
      <a href="/users" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <line x1="23" y1="11" x2="17" y2="11"/><line x1="20" y1="8" x2="20" y2="14"/>
        </svg>
        Staff
      </a>
      <a href="/logs" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
        Logs
      </a>
      <a href="/branches" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Branches
      </a>
      <% } %>
      <% if (user.role === 'super_admin') { %>
      <a href="/archive" class="nav-link">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="21 8 21 21 3 21 3 8"/>
          <rect x="1" y="3" width="22" height="5"/>
          <line x1="10" y1="12" x2="14" y2="12"/>
        </svg>
        Archive
      </a>
      <% } %>
    </nav>
    <div class="sidebar-user">
      <div class="user-avatar"><%= user.name[0].toUpperCase() %></div>
      <div class="user-info">
        <div class="user-name"><%= user.name %></div>
        <span class="role-badge <%= user.role %>"><%= roleLabels[user.role] || user.role %></span>
      </div>
    </div>
  </aside>

  <!-- ── Main Content ──────────────────────────── -->
  <div class="main-content">

    <!-- Topbar -->
    <header class="topbar">
      <div class="topbar-breadcrumb">
        <a href="/dashboard" class="back-link">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Dashboard
        </a>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" class="breadcrumb-sep"><path d="M9 18l6-6-6-6"/></svg>
        <a href="/clients/<%= client._id %>" class="back-link"><%= client.name %></a>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" class="breadcrumb-sep"><path d="M9 18l6-6-6-6"/></svg>
        <span class="breadcrumb-current">Loan · <%= account.accountNumber %></span>
      </div>
      <a href="/clients/<%= client._id %>" class="btn-cancel">Back</a>
    </header>

    <div class="page-content">

      <!-- ── Page heading ──────────────────────── -->
      <div class="client-header" style="margin-bottom:1.25rem">
        <div class="client-avatar" style="background:linear-gradient(135deg,#f59e0b,#d97706)">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#fff" stroke-width="1.5">
            <rect x="2" y="7" width="20" height="14" rx="2"/>
            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
          </svg>
        </div>
        <div class="client-info">
          <div class="client-name" style="display:flex;align-items:center;gap:.6rem">
            Loan Account
            <% if (loan) { %>
            <span class="loan-status-pill <%= loan.status %>"><%= loan.status %></span>
            <% } else { %>
            <span class="loan-status-pill none">no active loan</span>
            <% } %>
          </div>
          <div class="client-meta">
            <span><%= account.accountNumber %></span>
            <span>&middot;</span>
            <span><%= client.name %></span>
            <span>&middot;</span>
            <span>Balance: <strong>₵<%= fmt(account.balance) %></strong></span>
          </div>
        </div>
      </div>

      <!-- ── Action buttons ────────────────────── -->
      <div class="action-row">
        <% if (loan) { %>
        <a href="/clients/<%= client._id %>/transactions/new?account=<%= account._id %>"
           class="btn-loan-action primary">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          New Transaction
        </a>
        <% } %>
        <% if (!loan && isAdmin && account.status === 'active' && client.approvalStatus === 'approved') { %>
        <a href="/clients/<%= client._id %>/accounts/<%= account._id %>/loans/new"
           class="btn-loan-action amber">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Apply for Loan
        </a>
        <% } %>
        <a href="/clients/<%= client._id %>?account=<%= account._id %>" class="btn-loan-action secondary">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="17" y1="7" x2="7" y2="7"/>
            <polyline points="14 4 17 7 14 10"/>
            <line x1="7" y1="17" x2="17" y2="17"/>
            <polyline points="10 14 7 17 10 20"/>
          </svg>
          Transaction History
        </a>
        <% if (isAdmin && loan) { %>
          <% if (account.balance === 0) { %>
          <form method="POST" action="/clients/<%= client._id %>/accounts/<%= account._id %>/loans/close" style="display:inline">
            <button type="submit" class="btn-loan-action danger"
              data-confirm="Close this loan permanently? This cannot be undone.">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Close Loan
            </button>
          </form>
          <% } else { %>
          <button class="btn-loan-action muted" disabled
            title="Balance must be ₵0.00 to close (outstanding: ₵<%= fmt(account.balance) %>)">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Close Loan
          </button>
          <% } %>
        <% } %>
      </div>

      <% if (loan) { %>

      <!-- ── KPI cards ──────────────────────────── -->
      <div class="stats-grid" style="margin-bottom:1.25rem">
        <div class="stat-card">
          <div class="stat-icon amber">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <div>
            <div class="stat-value">₵<%= fmt(loan.principal) %></div>
            <div class="stat-label">Principal Disbursed</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon indigo">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <div>
            <div class="stat-value">₵<%= fmt(account.balance) %></div>
            <div class="stat-label">Outstanding Balance</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon red">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="19" y1="5" x2="5" y2="19"/>
              <circle cx="6.5" cy="6.5" r="2.5"/>
              <circle cx="17.5" cy="17.5" r="2.5"/>
            </svg>
          </div>
          <div>
            <div class="stat-value">₵<%= fmt(totalInterestCharged) %></div>
            <div class="stat-label">Total Interest Charged</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div>
            <div class="stat-value"><%= periodsRemaining %> / <%= periodsTotal %></div>
            <div class="stat-label">Periods Remaining</div>
          </div>
        </div>
      </div>

      <!-- ── Loan details ───────────────────────── -->
      <div class="loan-detail-grid">

        <!-- Terms -->
        <div class="loan-info-card">
          <div class="loan-info-card-title">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            Loan Terms
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Principal</span>
            <span class="loan-info-val">₵<%= fmt(loan.principal) %></span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Interest rates</span>
            <span class="loan-info-val">
              <span class="rate-row">
                <span class="rate-chip first"><%= loan.initialRate %>% first</span>
                <span class="rate-chip subsequent"><%= loan.subsequentRate %>% then</span>
              </span>
            </span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Amortization</span>
            <span class="loan-info-val"><%= loan.amortization %> month<%= loan.amortization !== 1 ? 's' : '' %></span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Interest frequency</span>
            <span class="loan-info-val" style="text-transform:capitalize"><%= loan.interestFrequency %></span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Start date</span>
            <span class="loan-info-val"><%= fmtDate(loan.startDate) %></span>
          </div>
        </div>

        <!-- Status -->
        <div class="loan-info-card">
          <div class="loan-info-card-title">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            Repayment Progress
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Status</span>
            <span class="loan-info-val">
              <span class="loan-status-pill <%= loan.status %>"><%= loan.status %></span>
            </span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Periods charged</span>
            <span class="loan-info-val amber"><%= loan.periodsCharged %> of <%= periodsTotal %></span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Next interest date</span>
            <span class="loan-info-val"><%= fmtDate(loan.nextInterestDate) %></span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Outstanding balance</span>
            <span class="loan-info-val <%= account.balance > 0 ? 'red' : 'green' %>">₵<%= fmt(account.balance) %></span>
          </div>
          <div class="loan-info-row">
            <span class="loan-info-key">Interest charged to date</span>
            <span class="loan-info-val red">₵<%= fmt(totalInterestCharged) %></span>
          </div>
          <!-- Progress bar -->
          <div style="margin-top:.75rem">
            <div class="progress-bar-wrap">
              <div class="progress-bar-fill" style="width:<%= progressPct %>%"></div>
            </div>
            <div class="progress-label">
              <span><%= progressPct %>% of periods elapsed</span>
              <span><%= periodsRemaining %> remaining</span>
            </div>
          </div>
        </div>

      </div>

      <% } else { %>

      <!-- ── No active loan ─────────────────────── -->
      <div class="no-loan-state">
        <div class="no-loan-state-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="7" width="20" height="14" rx="2"/>
            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
            <line x1="12" y1="12" x2="12" y2="16"/>
            <line x1="10" y1="14" x2="14" y2="14"/>
          </svg>
        </div>
        <h3>No Active Loan</h3>
        <p>This loan account has no active loan. <%= isAdmin ? 'Use the button below to disburse one.' : 'Contact an admin to apply.' %></p>
        <% if (isAdmin && account.status === 'active' && client.approvalStatus === 'approved') { %>
        <a href="/clients/<%= client._id %>/accounts/<%= account._id %>/loans/new"
           class="btn-loan-action amber" style="margin:0 auto">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Apply for Loan
        </a>
        <% } %>
      </div>

      <% } %>

      <!-- ── Interest Charge History ────────────── -->
      <div style="margin-top:1.25rem">
        <div class="section-header">
          <h3>Interest Charge History</h3>
          <% if (interestTxns.length) { %>
          <span style="font-size:.8rem;color:#64748b;font-weight:500">
            <%= interestTxns.length %> charge<%= interestTxns.length !== 1 ? 's' : '' %> &middot;
            Total ₵<%= fmt(totalInterestCharged) %>
          </span>
          <% } %>
        </div>
        <div class="table-wrap">
          <% if (!interestTxns.length) { %>
          <div class="empty-interest">No interest charges recorded yet.</div>
          <% } else { %>
          <table class="txn-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Amount Charged</th>
                <th>Balance After</th>
                <th>Reference</th>
              </tr>
            </thead>
            <tbody>
              <% interestTxns.forEach(t => { %>
              <tr>
                <td style="white-space:nowrap;color:#64748b;font-size:.8rem">
                  <%= new Date(t.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </td>
                <td style="color:#374151"><%= t.description %></td>
                <td><span class="txn-amount">−₵<%= fmt(t.amount) %></span></td>
                <td><span class="txn-balance">₵<%= fmt(t.balanceAfter) %></span></td>
                <td><span class="txn-ref"><%= t.reference || '—' %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>

      <!-- ── Past Loans ─────────────────────────── -->
      <% const pastLoans = allLoans.filter(l => l.status !== 'active'); %>
      <% if (pastLoans.length) { %>
      <div style="margin-top:1.25rem">
        <div class="section-header">
          <h3>Past Loans</h3>
          <span style="font-size:.8rem;color:#64748b;font-weight:500"><%= pastLoans.length %> loan<%= pastLoans.length !== 1 ? 's' : '' %></span>
        </div>
        <div class="table-wrap">
          <table class="txn-table">
            <thead>
              <tr>
                <th>Start Date</th>
                <th>Principal</th>
                <th>Rates</th>
                <th>Term</th>
                <th>Frequency</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% pastLoans.forEach(l => { %>
              <tr>
                <td style="white-space:nowrap;color:#64748b;font-size:.8rem"><%= fmtDate(l.startDate) %></td>
                <td><span class="txn-balance">₵<%= fmt(l.principal) %></span></td>
                <td>
                  <span class="rate-chip first" style="font-size:.7rem"><%= l.initialRate %>%</span>
                  <span class="rate-chip subsequent" style="font-size:.7rem;margin-left:.2rem"><%= l.subsequentRate %>%</span>
                </td>
                <td style="color:#374151"><%= l.amortization %> mo</td>
                <td style="text-transform:capitalize;color:#374151"><%= l.interestFrequency %></td>
                <td><span class="loan-status-pill <%= l.status %>"><%= l.status %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

    </div>
  </div>
</div>

<!-- ── Mobile: backdrop + drawer toggle ─────────────── -->
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeSidebar()"></div>

<!-- ── Mobile: bottom navigation bar ───────────────── -->
<nav class="mobile-nav">
  <a href="/dashboard" class="mobile-nav-item" data-path="/dashboard">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
      <rect x="3" y="3" width="7" height="7" rx="1"/>
      <rect x="14" y="3" width="7" height="7" rx="1"/>
      <rect x="3" y="14" width="7" height="7" rx="1"/>
      <rect x="14" y="14" width="7" height="7" rx="1"/>
    </svg>
    Home
  </a>
  <a href="/clients" class="mobile-nav-item active" data-path="/clients">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
    </svg>
    Clients
  </a>
  <a href="/transactions" class="mobile-nav-item" data-path="/transactions">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
      <line x1="17" y1="7" x2="7" y2="7"/>
      <polyline points="14 4 17 7 14 10"/>
      <line x1="7" y1="17" x2="17" y2="17"/>
      <polyline points="10 14 7 17 10 20"/>
    </svg>
    Txns
  </a>
  <button class="mobile-nav-item" onclick="openSidebar()">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
    Menu
  </button>
</nav>

<script>
  function openSidebar() {
    document.getElementById('sidebar').classList.add('open');
    document.getElementById('sidebarBackdrop').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarBackdrop').classList.remove('open');
    document.body.style.overflow = '';
  }
</script>
<script src="/js/modal.js"></script>
</body>
</html>
